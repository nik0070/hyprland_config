(url, headers=headers)\nsoup = BeautifulSoup(r.text, 'html.parser')\nnav = soup.find('nav', class_=re.compile(r'subsec_nav', re.I))\n\n# Let's find all primary industry links:\n# They either have div.subLevel > a OR div.miniMenu > a\n# Or simply a[itemprop='url'] with 2 path segments after /industry/\nindustries = []\nseen = set()\n\n# Grab both subLevel and miniMenu (the 'More' dropdown)\nfor a in nav.find_all('a', attrs={'itemprop': 'url'}):\n    href = a.get('href', '')\n    name = a.get_text(' ', strip=True)\n    \n    # Filter to only the main industry category pages (e.g. /industry/auto, /industry/transportation)\n    # Exclude sub-articles or deep article lists\n    if '/industry/' in href and not href.endswith('.cms') and href not in seen and name and name != 'More':\n        # Ensure it is a direct industry page (not sub-sub page like /industry/banking/finance/banking)\n        parts = [p for p in href.split('economictimes.indiatimes.com/industry/')[-1].split('/') if p]\n        if len(parts) <= 2: # e.g. auto, banking/finance, transportation, telecom\n            seen.add(href)\n            industries.append({'industry': name, 'link': href})\n\ndf = pd.DataFrame(industries)\nprint(df.to_string())\n\")"
