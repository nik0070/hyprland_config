autifulSoup(html, 'html.parser')\n    rows, seen = [], set()\n    for header in soup.find_all(['h2', 'h3']):\n        a = header.find('a')\n        if not a:\n            continue\n        section = a.get_text(' ', strip=True)\n        next_header = header.find_next(['h2', 'h3'])\n        sib = header.next_sibling\n        collected_lis = []\n        while sib is not None and sib is not next_header:\n            if isinstance(sib, Tag):\n                collected_lis.extend(sib.find_all('li'))\n            sib = sib.next_sibling\n        for li in collected_lis:\n            for anchor in li.find_all('a'):\n                text = anchor.get_text(' ', strip=True)\n                if not text or text == section or len(text) < 3:\n                    continue\n                key = (section, text)\n                if key in seen:\n                    continue\n                seen.add(key)\n                rows.append({'section': section, 'headline': text})\n    return pd.DataFrame(rows, columns=['section', 'headline'])\n\nheaders = {'User-Agent': 'Mozilla/5.0'}\nfor test_url in ['https://economictimes.indiatimes.com/industry/auto', 'https://economictimes.indiatimes.com/industry/transportation', 'https://economictimes.indiatimes.com/tech']:\n    r = requests.get(test_url, headers=headers)\n    df = parse_section_headlines(r.text)\n    print(test_url, '--> headlines found:', len(df))\n    if len(df) > 0:\n        print('Sample:', df.head(2).to_dict(orient='records'))\n\")"

